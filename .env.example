# TeensMate AI - 환경변수 설정 가이드

이 파일을 `.env`로 복사하여 사용하세요:
```bash
cp .env.example .env
```

그런 다음 실제 값으로 수정하세요.

## Azure OpenAI (필수)
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_API_KEY=your-api-key-here

# 배포된 모델 이름
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002

## Naver API (뉴스 크롤링 - 선택)
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret

## KIS API (주식 데이터 - 선택)
KIS_HTS_ID=your-hts-id
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret

## ChromaDB (자동 설정됨, 기존 DB 경로 유지)
CHROMA_PERSIST_DIR=./crawler
CHROMA_EDU_DB=./crawler/chroma_edu_db
CHROMA_NEWS_DB=./crawler/chroma_news_db
CHROMA_REPORT_DB=./crawler/chroma_report_db
CHROMA_VALCHAIN_DB=./crawler/chroma_valchain_db

## LLM 설정
DEFAULT_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

## 애플리케이션 설정
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

## 서버 설정
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
