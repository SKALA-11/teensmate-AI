# 환경변수 예제 파일
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요.

# Azure OpenAI 설정
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_API_KEY=your-api-key-here
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002

# OpenAI API (선택 사항, Azure OpenAI를 사용하면 자동 설정됨)
# OPENAI_API_KEY=your-openai-api-key

# Naver API (뉴스 크롤링용, 선택 사항)
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret

# 한국투자증권 API (주식 데이터용, 선택 사항)
# KIS_APP_KEY=your-kis-app-key
# KIS_APP_SECRET=your-kis-app-secret

# Vector Database 설정 (기본값 사용 가능)
# CHROMA_PERSIST_DIR=./crawler
# CHROMA_EDU_DB=./crawler/chroma_edu_db
# CHROMA_NEWS_DB=./crawler/chroma_news_db
# CHROMA_REPORT_DB=./crawler/chroma_report_db
# CHROMA_VALCHAIN_DB=./crawler/chroma_valchain_db

# LLM 설정
# DEFAULT_MODEL=gpt-4o
# DEFAULT_TEMPERATURE=0.2
# DEFAULT_MAX_TOKENS=2048

# 애플리케이션 설정
# APP_NAME=TeensMate-AI
# APP_VERSION=2.0.0
# DEBUG=False
# LOG_LEVEL=INFO

# FastAPI 설정
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=True

# Streamlit 설정
# STREAMLIT_PORT=8501
